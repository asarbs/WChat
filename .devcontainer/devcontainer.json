
// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "WChat",
	"build": {
		// Sets the run context to one level up instead of the .devcontainer folder.
		"context": "..",
		// Update the 'dockerFile' property if you aren't using the standard 'Dockerfile' filename.
		"dockerfile": "Dockerfile"
	},
	"runArgs": [
		"--device=/dev/input",
		"--device=/dev/snd"
	],
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-azuretools.vscode-docker",
				"ms-python.python",
				"batisteo.vscode-django",
				"bibhasdn.django-html",
				"yy0931.vscode-sqlite3-editor",
				"chop-dbhi.multiline-string-editor",
				"mhutchie.git-graph",
				"aeschli.vscode-css-formatter",
				"mohd-akram.vscode-html-format",
				"ZainChen.json",
				"dbaeumer.vscode-eslint",
				"jerrygoyal.shortcut-menu-bar",
				"donjayamanne.python-extension-pack",
				"vscode-icons-team.vscode-icons",
				"ms-vscode.makefile-tools",
				"ms-vscode.cpptools-extension-pack",
				"FleeXo.cpp-class-creator",
				"mechatroner.rainbow-csv",
				"josetr.cmake-language-support-vscode",
				"afmicc.GetterAndSetterGenerator",
				"janisdd.vscode-edit-csv",
				"zxh404.vscode-proto3",
				"streetsidesoftware.code-spell-checker",
				"streetsidesoftware.code-spell-checker-polish",
				"llvm-vs-code-extensions.vscode-clangd",
				"ms-vscode.cmake-tools"
			],
			"settings": {
				"cSpell.enabled": true,
				"cSpell.words": [
					"WChat",
					"websocketpp", 
					"protobuf",
					"SQLiteCpp", 
					"logger",
					"Volatile",
					"cpplint",
					"cppcheck",
					"clangd",
					"cmake"
				],
				"C_Cpp.intelliSenseEngine": "disabled",
				"editor.formatOnSave": true,
				"C_Cpp.clang_format_path": "/usr/bin/clang-format-18",
				"clang-format.executable": "/usr/bin/clang-format-18"
			}
		}
	},
	"portsAttributes": {
  		"9002": { "label": "WebSocket server", "onAutoForward": "openBrowser" }
	},
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Uncomment the next line to run commands after the container is created.
	// "postCreateCommand": "cat /etc/os-release",
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as an existing user other than the container default. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "devcontainer"
	"postCreateCommand": "make .setup && curl -fsSL https://opencode.ai/install | bash"
}
