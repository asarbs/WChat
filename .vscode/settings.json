{
    "files.insertFinalNewline":true,
    "files.trimTrailingWhitespace": true,
    "files.autoSave": "onFocusChange",

    "cmake.configureOnOpen": true,
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.buildDirectory": "${workspaceFolder}/build/linux",
    "cmake.generator": "Unix Makefiles",
    "cmake.configureSettings": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
    },

    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/linux/compile_commands.json",

    "clangd.arguments": [
        "--compile-commands-dir=build/linux",
        "--query-driver=/usr/bin/*++"
    ],

    "cSpell.enabled": true,
    "cSpell.words": [
        "WChat",
        "websocketpp", 
        "protobuf",
        "SQLiteCpp", 
        "logger",
        "Volatile",
        "cpplint",
        "cppcheck",
        "clangd",
        "cmake",
        "Asar",
        "Miniatures",
        "regiserClinetSession",
        "regiser",
        "unregiser",
        "Clinet"
    ],
    "C_Cpp.intelliSenseEngine": "default",
    "editor.formatOnSave": true,
    "C_Cpp.clang_format_path": "/usr/bin/clang-format-18",
    "clang-format.executable": "/usr/bin/clang-format-18",
    "files.associations": {
        "new": "cpp",
        "any": "cpp",
        "array": "cpp",
        "atomic": "cpp",
        "bit": "cpp",
        "*.tcc": "cpp",
        "bitset": "cpp",
        "cctype": "cpp",
        "chrono": "cpp",
        "clocale": "cpp",
        "cmath": "cpp",
        "compare": "cpp",
        "concepts": "cpp",
        "condition_variable": "cpp",
        "csignal": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "deque": "cpp",
        "forward_list": "cpp",
        "list": "cpp",
        "map": "cpp",
        "set": "cpp",
        "string": "cpp",
        "unordered_map": "cpp",
        "unordered_set": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "algorithm": "cpp",
        "functional": "cpp",
        "iterator": "cpp",
        "memory": "cpp",
        "memory_resource": "cpp",
        "numeric": "cpp",
        "optional": "cpp",
        "random": "cpp",
        "ratio": "cpp",
        "string_view": "cpp",
        "system_error": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp",
        "fstream": "cpp",
        "initializer_list": "cpp",
        "iomanip": "cpp",
        "iosfwd": "cpp",
        "iostream": "cpp",
        "istream": "cpp",
        "limits": "cpp",
        "mutex": "cpp",
        "numbers": "cpp",
        "ostream": "cpp",
        "semaphore": "cpp",
        "span": "cpp",
        "sstream": "cpp",
        "stdexcept": "cpp",
        "stop_token": "cpp",
        "streambuf": "cpp",
        "thread": "cpp",
        "typeinfo": "cpp",
        "variant": "cpp",
        "cinttypes": "cpp",
        "codecvt": "cpp",
        "future": "cpp",
        "ranges": "cpp",
        "regex": "cpp",
        "valarray": "cpp",
        "queue": "cpp",
        "strstream": "cpp",
        "complex": "cpp",
        "coroutine": "cpp",
        "cuchar": "cpp",
        "source_location": "cpp",
        "typeindex": "cpp",
        "*.ipp": "cpp",
        "charconv": "cpp",
        "format": "cpp",
        "text_encoding": "cpp",
        "shared_mutex": "cpp",
        "*.inc": "cpp",
        "cfenv": "cpp",
        "scoped_allocator": "cpp",
        "stdfloat": "cpp"
    },
    "editor.acceptSuggestionOnEnter": "on",
    "C_Cpp.clang_format_path": "/usr/bin/clang-format-18",
    "clang-format.executable": "/usr/bin/clang-format-18",
    "cpp.creator.headerFileContentPreset": "/*\n * World VTT\n *\n * Copyright (C) 2025, Asar Miniatures\n * All rights reserved.\n *\n * This file is part of the [Project Name] project. It may be used, modified,\n * and distributed under the terms specified by the copyright holder.\n *\n */\n\n#ifndef {{*CLASSNAMEUPPER*}}_H\n#define {{*CLASSNAMEUPPER*}}_H\n\n#pragma once\n\nclass {{*CLASSNAME*}}\n{\n    public:\n        {{*CLASSNAME*}}();\n        virtual ~{{*CLASSNAME*}}();\n        {{*CLASSNAME*}}(const {{*CLASSNAME*}}& rhs);\n        {{*CLASSNAME*}}(const {{*CLASSNAME*}}&& rhs);\n        {{*CLASSNAME*}}& operator=(const {{*CLASSNAME*}}& rhs);\n        {{*CLASSNAME*}}& operator=(const {{*CLASSNAME*}}&& rhs);\nprotected:\n\nprivate:\n};\n\n#endif",
    "cpp.creator.sourceFileContentPreset": "/*\n * World VTT\n *\n * Copyright (C) 2025, Asar Miniatures\n * All rights reserved.\n *\n * This file is part of the [Project Name] project. It may be used, modified,\n * and distributed under the terms specified by the copyright holder.\n *\n */\n\n#include \"{{*HEADERFILENAME*}}\"\n\n#include \"logger.h\"\n\n{{*CLASSNAME*}}::{{*CLASSNAME*}}()\n{\n}\n   \n{{*CLASSNAME*}}::~{{*CLASSNAME*}}()\n{\n}\n\n{{*CLASSNAME*}}::{{*CLASSNAME*}}(const {{*CLASSNAME*}}& rhs) {\n}\n\n{{*CLASSNAME*}}::{{*CLASSNAME*}}(const {{*CLASSNAME*}}&& rhs) {\n}\n\n{{*CLASSNAME*}}& {{*CLASSNAME*}}::operator=(const {{*CLASSNAME*}}& rhs) {\n    if (this != &rhs) {\n    }\n    return *this;\n}\n\n{{*CLASSNAME*}}& {{*CLASSNAME*}}::operator=(const {{*CLASSNAME*}}&& rhs) {\n    if (this != &rhs) {\n    }\n    return *this;\n}",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.default.cppStandard": "c++20",
    "C_Cpp.default.intelliSenseMode": "linux-clang-x64",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.enhancedColorization": "enabled",
    "C_Cpp.intelliSenseCacheSize": 4096,
    "C_Cpp.workspaceParsingPriority": "medium",
    "C_Cpp.inlayHints.auto": true,
    "C_Cpp.inlayHints.parameterNames": true,
    "C_Cpp.inlayHints.referenceOperator": true,
    "python.analysis.extraPaths": [
        "test/app/common",
    ],
    "files.exclude": {
        "**/build": false,
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true
    },
    "search.exclude": {
        "**/build": true,
        "**/proto": true
    },
    "extensions.ignoreRecommendations": true
}
